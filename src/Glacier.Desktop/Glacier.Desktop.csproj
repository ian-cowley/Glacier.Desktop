<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <NoWarn>$(NoWarn);CS1591;CS8981</NoWarn>

    <!-- NuGet Package Properties -->
    <PackageId>Glacier.Desktop</PackageId>
    <Version>1.2.2</Version>
    <PackageReleaseNotes>v1.2.2: Bounded stackalloc &amp; invisible-child spacing fixes in FlexRow/FlexColumn, SIMD FlexColumn arrange, DockPanel clamping, swapchain finalizers, and aligned Graphics/Plot dependencies.</PackageReleaseNotes>
    <Authors>Ian Cowley</Authors>
    <Company>Glacier High-Performance Ecosystem</Company>
    <Description>Hardware-accelerated native desktop GUI engine, cross-platform windowing/audio HAL, and virtualized data grid for .NET 10 Native AOT. Sub-15ms cold startup, SIMD Kogge-Stone layout calculations, Glacier.Graphics integration, and 1,000,000+ row virtual grids at 120 FPS.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ian-cowley/Glacier.Desktop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ian-cowley/Glacier.Desktop.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>desktop;gui;tkinter;pyqt;aot;nativeaot;windowing;graphics;simd;datagrid;net10;glacier</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Glacier.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Glacier.Graphics/src/Glacier.Graphics/Glacier.Graphics.csproj" Condition="Exists('../../../Glacier.Graphics/src/Glacier.Graphics/Glacier.Graphics.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Graphics" Condition="!Exists('../../../Glacier.Graphics/src/Glacier.Graphics/Glacier.Graphics.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Plot/src/Glacier.Plot/Glacier.Plot.csproj" Condition="Exists('../../../Glacier.Plot/src/Glacier.Plot/Glacier.Plot.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Plot" Condition="!Exists('../../../Glacier.Plot/src/Glacier.Plot/Glacier.Plot.csproj') or '$(UseLocalProjectReferences)' == 'false'" />

    <ProjectReference Include="../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj" Condition="Exists('../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj') and '$(UseLocalProjectReferences)' != 'false'" />
    <PackageReference Include="Glacier.Polaris" Condition="!Exists('../../../Glacier.Polaris/src/Glacier.Polaris/Glacier.Polaris.csproj') or '$(UseLocalProjectReferences)' == 'false'" />
  </ItemGroup>
</Project>
